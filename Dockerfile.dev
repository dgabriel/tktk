# Local-dev-only image. Not a deploy artifact -- tktk still deploys to
# Cloudflare's actual platform via `wrangler deploy` / the GitHub Actions
# workflow, unrelated to this file. This exists purely so the dev server
# (wrangler's local Workers-runtime emulation) runs as a long-lived container
# process instead of a backgrounded shell job on the host, which was getting
# killed out from under whoever had it open. See docker-compose.yml for how
# source is mounted in and why node_modules is excluded from that mount.
FROM node:26-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm install

COPY . .

EXPOSE 8787

# --ip 0.0.0.0: without this wrangler dev only binds inside the container's
# own network namespace and the port mapping to the host never sees traffic.
CMD ["npx", "wrangler", "dev", "--ip", "0.0.0.0"]
