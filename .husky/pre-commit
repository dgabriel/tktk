npx lint-staged

# Flaught adversarial review of what's about to be committed. Deterministic
# checks (semgrep/linter/vuln_scanner) always run, no API key needed; the
# full LLM pass joins in when GROQ_API_KEY is set. Unlike the CI `flaught`
# job (non-blocking, CLAUDE.md "CI adversarial review"), this local gate
# DOES block: exit 1 (findings over severity_gate.fail_on) stops the commit.
#
# Never bypass with --no-verify. If this blocks you: fix what you're
# confident is a real issue and recommit; for anything you're not sure
# about, stop and report it rather than guessing or dismissing it yourself
# -- `flaught dismiss` is a human call, not an agent's.
#
# `git commit-tree` builds a throwaway commit object from the current index
# (staged content only, ignoring unstaged worktree changes) so Flaught has
# something to diff against HEAD -- this never touches HEAD, the index, or
# the working tree, and the object is left dangling for git to GC normally.
STAGED_TREE=$(git write-tree)
REVIEW_HEAD=$(git commit-tree "$STAGED_TREE" -p HEAD -m "pre-commit review snapshot")

if [ -n "$GROQ_API_KEY" ]; then
  npx flaught review --base HEAD --head "$REVIEW_HEAD" --quiet
else
  npx flaught review --base HEAD --head "$REVIEW_HEAD" --no-llm --quiet
fi
FLAUGHT_EXIT=$?

if [ "$FLAUGHT_EXIT" -eq 2 ]; then
  echo "flaught: tool error (config/API/LLM fault, not a code problem) -- not blocking commit" >&2
elif [ "$FLAUGHT_EXIT" -ne 0 ]; then
  exit "$FLAUGHT_EXIT"
fi
