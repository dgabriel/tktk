#!/usr/bin/env sh

# Catches CI failures locally before they cost a round-trip. See
# docs/git-hygiene.md "Pre-flight before pushing". No test suite exists yet
# (CLAUDE.md) -- add `npm test` here once tester produces a runnable one.

# Skip checks when only deleting remote branches (local SHA is all zeros on deletions)
zero_sha="0000000000000000000000000000000000000000"
pushing_code=0
while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" != "$zero_sha" ] && pushing_code=1
done
[ "$pushing_code" -eq 0 ] && exit 0

npm run typecheck
npm run lint
